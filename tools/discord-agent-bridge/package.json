{
  "name": "@luminary/discord-agent-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord bridge for Luminary OpenClaw and Hermes agents on Node-02.",
  "scripts": {
    "setup:env": "powershell -ExecutionPolicy Bypass -File scripts/setup-env.ps1",
    "setup": "tsx src/setup.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:compiled": "node dist/index.js"
  },
  "dependencies": {
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
